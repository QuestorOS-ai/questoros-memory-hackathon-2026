{
  "name": "questoros-memory-hackathon-2026",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": "https://github.com/QuestorOS-ai/questoros-memory-hackathon-2026",
  "description": "QuestorOS Memory — ICARE3 judge reference implementation using CockroachDB and AWS Bedrock",
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx src/server.ts",
    "start": "node --env-file=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:init": "node --env-file=.env --import tsx scripts/init-db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.864.0",
    "fastify": "^5.5.0",
    "pg": "^8.16.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
