# CockroachDB connection string. Use a dedicated demo database/cluster.
DATABASE_URL=postgresql://username:password@host:26257/defaultdb?sslmode=verify-full

# Least-privilege demo key used by the reference API.
JUDGE_API_KEY=qmem_live_replace_me

# Synthetic demo identity/scope.
DEMO_TENANT_ID=hackathon-tenant
DEMO_ACTOR_ID=hackathon-judge
DEMO_WORKSPACE_ID=harborview-demo

# AWS Bedrock embedding configuration. The Memory API may run in another AWS
# region; Bedrock inference for the current staging design is in us-west-2.
AWS_BEDROCK_REGION=us-west-2
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

PORT=8788
